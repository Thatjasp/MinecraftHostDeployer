# Copy to .env and fill in.

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Free key from https://console.curseforge.com (needed for CurseForge pack installs)
CF_API_KEY=

# Host folder holding Minecraft server data and uploaded modpacks.
# Mounted into the panel at the SAME path so paths given to Docker match.
# Must be writable by UID 1000 (the panel and itzg containers run as 1000).
MC_ROOT=/srv/mcpanel

# Port the panel listens on (bound to 127.0.0.1 only)
PANEL_PORT=8080
